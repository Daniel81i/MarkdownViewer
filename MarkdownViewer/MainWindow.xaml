<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:adl="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Markdown Viewer"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DataTemplate x:Key="OutlineItemTemplate">
            <Border Padding="{Binding IndentPadding}"
                    Background="Transparent">
                <TextBlock Text="{Binding Title}"
                           ToolTip="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DirectoryFileItemTemplate">
            <Border Padding="8,4"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActiveDocument}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AppSelectionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip="{Binding FullPath}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="{Binding LastUpdatedText}"
                               ToolTip="{Binding FullPath}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DocumentHeaderTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="2,3">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           Text="&#xE8A5;"
                           VerticalAlignment="Center"
                           Margin="0,1,6,0"
                           Opacity="0.8" />
                <TextBlock Text="{Binding Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="OutlineListBoxItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
        </Style>

        <Style x:Key="DirectoryFileListBoxItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
            <EventSetter Event="Loaded"
                         Handler="DirectoryFileListBoxItem_Loaded" />
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="DirectoryFileListBoxItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="DirectoryFileListBoxItem_PreviewMouseRightButtonDown" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="ToolbarBorder"
                AllowDrop="True"
                Padding="8"
                BorderBrush="{DynamicResource AppToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource AppToolbarBackgroundBrush}"
                DragOver="ToolbarBorder_DragOver"
                Drop="ToolbarBorder_Drop">
            <Border.ContextMenu>
                <ContextMenu x:Name="ToolbarContextMenu">
                    <MenuItem Header="設定"
                              Click="ToolbarSettingsMenuItem_Click" />
                    <MenuItem Header="バージョン情報"
                              Click="ToolbarAboutMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="リリースページを表示"
                              Click="OpenReleasePageMenuItem_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <ToggleButton x:Name="HistoryToggleButton"
                                  Padding="0"
                                  Width="32"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  IsChecked="True"
                                  Click="HistoryToggleButton_Click"
                                  ToolTip="タブ一覧の表示/非表示">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE700;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ToggleButton>

                    <Button x:Name="OpenFileButton"
                            Padding="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OpenFileButton_Click"
                            ToolTip="ファイル選択">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE8B7;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="ReloadButton"
                            Padding="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="ReloadButton_Click"
                            ToolTip="再読み込み">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE72C;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="GoToLineButton"
                            Padding="0"
                            Width="40"
                            Height="32"
                            Click="GoToLineButton_Click"
                            ToolTip="指定行へ移動">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE1D3;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="PathTextBlock"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextSubtleBrush}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="OutlineLayoutButton"
                            Padding="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OutlineLayoutButton_Click"
                            ToolTip="アウトラインを表示">
                        <TextBlock x:Name="OutlineLayoutIconTextBlock"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE8A9;"
                                   Foreground="{DynamicResource AppIconBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <ToggleButton x:Name="SourceViewToggleButton"
                                  Padding="0"
                                  Width="32"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Click="SourceViewToggleButton_Click"
                                  ToolTip="ソース表示">
                        <TextBlock x:Name="SourceViewIconTextBlock"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE943;"
                                   Foreground="{DynamicResource AppIconBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ToggleButton>

                    <ToggleButton x:Name="UnsafeHtmlToggleButton"
                                  Padding="0"
                                  Width="32"
                                  Height="32"
                                  Click="UnsafeHtmlToggleButton_Click"
                                  ToolTip="HTMLサニタイズを無効化">
                        <TextBlock x:Name="UnsafeHtmlIconTextBlock"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE7BA;"
                                   Foreground="{DynamicResource AppIconBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ToggleButton>

                    <Button x:Name="SettingsButton"
                            Padding="0"
                            Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Click="SettingsButton_Click"
                            ToolTip="メニュー">
                        <TextBlock FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   Text="&#x22EE;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ad:DockingManager Grid.Row="1"
                               x:Name="MainDockingManager"
                               DocumentHeaderTemplate="{StaticResource DocumentHeaderTemplate}"
                               ActiveContentChanged="MainDockingManager_ActiveContentChanged"
                               DocumentClosed="MainDockingManager_DocumentClosed">
                <ad:DockingManager.DocumentContextMenu>
                    <ContextMenu>
                        <MenuItem Header="閉じる"
                                  Command="{Binding CloseCommand}" />
                        <MenuItem Header="これ以外を閉じる"
                                  Command="{Binding CloseAllButThisCommand}" />
                        <MenuItem Header="右側を閉じる"
                                  CommandParameter="{Binding}"
                                  Click="CloseDocumentsToRightMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="エクスプローラで開く"
                                  CommandParameter="{Binding}"
                                  Click="OpenDocumentInExplorerMenuItem_Click" />
                    </ContextMenu>
                </ad:DockingManager.DocumentContextMenu>
                <adl:LayoutRoot>
                    <adl:LayoutPanel Orientation="Horizontal">
                        <adl:LayoutAnchorablePaneGroup DockWidth="220">
                            <adl:LayoutAnchorablePane>
                                <adl:LayoutAnchorable x:Name="HistoryAnchorable"
                                                      Title="履歴"
                                                      ContentId="HistoryPane"
                                                      CanClose="False"
                                                      CanDockAsTabbedDocument="False"
                                                      AutoHideWidth="220"
                                                      AutoHideHeight="280">
                                    <Border Background="{DynamicResource AppPaneBackgroundBrush}">
                                        <ListBox x:Name="HistoryListBox"
                                                 AllowDrop="True"
                                                 BorderThickness="0"
                                                 DragOver="HistoryListBox_DragOver"
                                                 DragLeave="HistoryListBox_DragLeave"
                                                 Drop="HistoryListBox_Drop"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="HistoryListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding"
                                                            Value="0" />
                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Stretch" />
                                                    <EventSetter Event="Loaded"
                                                                 Handler="HistoryListBoxItem_Loaded" />
                                                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                                                 Handler="HistoryListBoxItem_PreviewMouseLeftButtonDown" />
                                                    <EventSetter Event="PreviewMouseMove"
                                                                 Handler="HistoryListBoxItem_PreviewMouseMove" />
                                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                                 Handler="HistoryListBoxItem_PreviewMouseRightButtonDown" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0"
                                                            HorizontalAlignment="Stretch"
                                                            BorderBrush="{DynamicResource AppDropIndicatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness"
                                                                        Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDropTargetBefore}"
                                                                                 Value="True">
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0,2,0,0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDropTargetAfter}"
                                                                                 Value="True">
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0,0,0,2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Margin="6,4">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       ToolTip="{Binding FullPath}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppTextBrush}" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       ToolTip="{Binding FullPath}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                                                       Margin="0,1,0,0"
                                                                       Visibility="{Binding SecondaryTextVisibility}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </adl:LayoutAnchorable>
                                <adl:LayoutAnchorable x:Name="FilesAnchorable"
                                                      Title="ファイル"
                                                      ContentId="FilesPane"
                                                      CanClose="False"
                                                      CanDockAsTabbedDocument="False"
                                                      AutoHideWidth="220"
                                                      AutoHideHeight="280">
                                    <Border x:Name="FilesPaneContentRoot"
                                            Background="{DynamicResource AppPaneBackgroundBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Margin="0"
                                                    Padding="8,8,8,6"
                                                    Background="{DynamicResource AppPaneHeaderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource AppPaneHeaderBorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                                                   Text="並び順" />

                                                        <ComboBox x:Name="FilesSortComboBox"
                                                                  Grid.Column="1"
                                                                  MinWidth="120"
                                                                  Height="28"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalContentAlignment="Center"
                                                                  SelectionChanged="FilesSortComboBox_SelectionChanged">
                                                            <ComboBoxItem Tag="LastWriteTimeDescending"
                                                                          Content="更新日時降順" />
                                                            <ComboBoxItem Tag="FileNameAscending"
                                                                          Content="ファイル名昇順" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <Grid Grid.Row="1"
                                                          Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock x:Name="CurrentDirectoryPathTextBlock"
                                                                   Grid.Column="0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Cursor="Hand"
                                                                   Background="Transparent"
                                                                   MouseLeftButtonDown="CurrentDirectoryPathTextBlock_MouseLeftButtonDown" />

                                                        <TextBlock x:Name="CurrentDirectoryPathCopiedTextBlock"
                                                                   Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppSuccessTextBrush}"
                                                                   Text="コピーしました"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <ListBox x:Name="DirectoryFileListBox"
                                                     Grid.Row="1"
                                                     BorderThickness="0"
                                                     ItemTemplate="{StaticResource DirectoryFileItemTemplate}"
                                                     ItemContainerStyle="{StaticResource DirectoryFileListBoxItemStyle}" />
                                        </Grid>
                                    </Border>
                                </adl:LayoutAnchorable>
                            </adl:LayoutAnchorablePane>
                        </adl:LayoutAnchorablePaneGroup>

                        <adl:LayoutDocumentPaneGroup>
                            <adl:LayoutDocumentPane x:Name="MarkdownDocumentPane" />
                        </adl:LayoutDocumentPaneGroup>

                        <adl:LayoutAnchorablePaneGroup DockWidth="260">
                            <adl:LayoutAnchorablePane>
                                <adl:LayoutAnchorable x:Name="OutlineAnchorable"
                                                      Title="アウトライン"
                                                      ContentId="OutlinePane"
                                                      CanClose="False"
                                                      CanDockAsTabbedDocument="False"
                                                      AutoHideWidth="260"
                                                      AutoHideHeight="240">
                                    <Border Background="{DynamicResource AppOutlineBackgroundBrush}">
                                        <ListBox x:Name="OutlineListBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ItemTemplate="{StaticResource OutlineItemTemplate}"
                                                 ItemContainerStyle="{StaticResource OutlineListBoxItemStyle}"
                                                 SelectionChanged="OutlineListBox_SelectionChanged" />
                                    </Border>
                                </adl:LayoutAnchorable>
                            </adl:LayoutAnchorablePane>
                        </adl:LayoutAnchorablePaneGroup>
                    </adl:LayoutPanel>
                </adl:LayoutRoot>
            </ad:DockingManager>
    </Grid>
</Window>
